# Copy to .env.local for local development, and set the same two values in your
# hosting provider's environment settings (Vercel -> Project -> Settings -> Environment Variables).
#
# Find both in Supabase: Project Settings -> API.
# Without them the site still runs, using a built-in demo catalogue, but checkout, the
# custom order and contact forms, and the admin panel need a database.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: shown on the Contact page and in the footer. Anything left empty is not displayed.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_TWITTER_URL=
NEXT_PUBLIC_LINKEDIN_URL=
